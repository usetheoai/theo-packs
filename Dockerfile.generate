# theokit-packs-runner — Dockerfile generator for Argo Workflow build pipeline.
# Analyzes source code and produces an optimized Dockerfile.
# MEET-2026-03-29-017: Replaces hardcoded bash Dockerfile templates.
#
# Build: docker build -f Dockerfile.generate -t theokit-packs-runner .
# Run:   theokit-packs-generate --source /workspace --app-path apps/api --output /workspace/Dockerfile.api

FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /theokit-packs-generate ./cmd/theokit-packs-generate

# Minimal runtime — ~20MB total
FROM alpine:3.20

# T2.2 — Create a dedicated non-root user (UID 10001) and run the binary
# under it. Defense-in-depth: the runner executes inside an Argo
# Workflow step in a multi-tenant build cluster; running as root would
# magnify the blast radius of any path-traversal / symlink / parser
# vulnerability that escapes the upstream sanitization. Theo's workflow
# must mount the source workspace with read/execute access for UID 10001.
RUN apk add --no-cache ca-certificates \
 && adduser -D -H -u 10001 theokit-packs

COPY --from=build /theokit-packs-generate /usr/local/bin/theokit-packs-generate

USER theokit-packs
ENTRYPOINT ["theokit-packs-generate"]
